"""
/v1/sparql — read-only SPARQL SELECT endpoint (stub).
Accepts GET ?query=... and POST application/x-www-form-urlencoded query=...
Full query features added in phase-04.
"""
from __future__ import annotations

from fastapi import APIRouter, HTTPException, Request
from fastapi.responses import JSONResponse

router = APIRouter(prefix="/v1", tags=["sparql"])


@router.get("/sparql")
async def sparql_get(request: Request, query: str = "") -> JSONResponse:
    return await _execute(request, query)


@router.post("/sparql")
async def sparql_post(request: Request) -> JSONResponse:
    form = await request.form()
    query = str(form.get("query", ""))
    return await _execute(request, query)


async def _execute(request: Request, query: str) -> JSONResponse:
    if not query.strip():
        raise HTTPException(status_code=400, detail="Missing SPARQL query")

    q_upper = query.strip().upper()
    if not q_upper.startswith("SELECT") and not q_upper.startswith("ASK"):
        raise HTTPException(status_code=403, detail="Only SELECT and ASK queries allowed")

    container = request.app.state.container
    try:
        rows = container.oxigraph.sparql_select(query)
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc)) from exc

    return JSONResponse({"results": rows, "count": len(rows)})
