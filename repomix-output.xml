  .slide--bleed .slide__subtitle { color: rgba(255,255,255,0.7); }

  /* ============ RESPONSIVE ============ */
  @media (max-height: 700px) {
    .slide { padding: clamp(24px, 4vh, 40px) clamp(32px, 6vw, 80px); }
