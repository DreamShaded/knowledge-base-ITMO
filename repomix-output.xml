  });

  it('ignores directories without SKILL.md', () => {
    createSkill(globalDir, 'valid-skill');
    fs.mkdirSync(path.join(globalDir, 'no-skill-md'));
    const result = listSkillNames(globalDir);
    assert.deepStrictEqual(result, ['valid-skill']);
  });

