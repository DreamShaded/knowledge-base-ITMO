    assert.deepStrictEqual(listSkillNames('/nonexistent/path'), []);
  });

  it('returns empty array for empty directory', () => {
    assert.deepStrictEqual(listSkillNames(globalDir), []);
  });

  it('returns skill names that have SKILL.md', () => {
