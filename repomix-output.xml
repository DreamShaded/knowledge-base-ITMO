  /* ============ SLIDE TYPE: FULL-BLEED ============ */
  .slide--bleed {
    padding: 0;
    justify-content: flex-end;
  }

  .slide__bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    z-index: 0;
  }

  .slide__bg--gradient {
    background: linear-gradient(135deg, #1a0f3c 0%, #0f1729 40%, #162040 100%);
  }

  .slide__scrim {
    position: absolute; inset: 0;
