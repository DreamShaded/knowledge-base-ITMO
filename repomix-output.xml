  .slide__aside {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  /* ============ SLIDE TYPE: SPLIT ============ */
  .slide--split { padding: 0; }

  .slide--split .slide__panels {
    display: grid;
    grid-template-columns: 3fr 2fr;
    height: 100%;
  }

  .slide--split .slide__panel {
    padding: clamp(40px, 6vh, 80px) clamp(32px, 4vw, 60px);
