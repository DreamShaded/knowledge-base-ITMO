    if output_dir is None:
        output_dir = "."
    os.makedirs(output_dir, exist_ok=True)

    results = []
    slug = name or re.sub(r'[^a-zA-Z0-9_-]', '_', prompt.split()[0].lower())
    style_suffix = f"_{style}" if style else ""

    for size in sizes:
