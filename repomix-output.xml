    footer: { text: `Project • ${projectName}` },
    fields: [
      { name: '⏰ Time', value: formatTimestamp(), inline: true },
      { name: '🆔 Session', value: `\`${truncateSessionId(sessionId)}\``, inline: true },
      { name: '📍 Location', value: `\`${cwd || 'Unknown'}\``, inline: false },
    ],
