[Unit]
Description=Knowledge Base FastAPI Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/r/common/code/knowledge-base
ExecStart=/home/r/common/code/knowledge-base/.venv/bin/python3 -m app run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
Environment="PATH=/home/r/common/code/knowledge-base/.venv/bin:/home/r/.gvm/bin:/home/r/.nvm/versions/node/v24.14.0/bin:/home/r/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/opt/cuda/bin:/usr/bin/site_perl:/usr/bin/vendor_perl:/usr/bin/core_perl:/home/r/.rsvm/current/dist/bin:/home/r/.rsvm/current/cargo/bin"
Environment="HF_HOME=/home/r/common/code/knowledge-base/data/models"
Environment="KB_PROFILE=laptop-4070-8gb"
Environment="PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True"
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kb-app

[Install]
WantedBy=default.target